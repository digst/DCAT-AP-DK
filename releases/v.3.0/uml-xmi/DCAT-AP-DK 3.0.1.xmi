						<tag xmi:id="EAID_A2757715_43C4_FFF1_9D89_35DFD3D8C6F2" name="applicationNote (da)" value="&lt;memo&gt;$ea_notes=Denne egenskab angiver hvilken tilstand distributionen befinder sig ift. udvikling og ibrugtagning. Til angivelse af status skal følgende klassifikation anvendes: ADMS Status, http://purl.org/adms/status/ (Udfaldsrum: Completed, Deprecated, Under Development, Withdrawn)"/>
						<tag xmi:id="EAID_A44932CD_0E4C_F045_BAA9_A91A3C374CEF" name="URI" value="http://www.w3.org/ns/adms#status"/>
