					<tag xmi:id="EAID_E4EE217F_7139_6771_B618_A2BD25EE6638" name="definition (da)" value="&lt;memo&gt;#NOTES#&#xA;En aktivitet er noget der sker over en tidsperiode og påvirker eller interagerer med entiteter; dette kan inkludere forbrug, behandling, transformation, ændring, omplacering, anvendelse eller skabelse af entiteter. " modelElement="EAID_B81B9059_D11E_AC87_ABA2_154557706DC8"/>
					<tag xmi:id="EAID_E4EE276D_7727_6777_8FEE_0B18B8113D0C" name="definition (en)" value="&lt;memo&gt;#NOTES#An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities. " modelElement="EAID_B81B9059_D11E_AC87_ABA2_154557706DC8"/>
