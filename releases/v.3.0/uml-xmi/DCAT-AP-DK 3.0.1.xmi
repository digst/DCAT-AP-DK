	<thecustomprofile:recommended base_Association="EAID_C6DCF47C_0930_4a27_8F8E_8FFB1AF1E579"/>
	<thecustomprofile:recommended base_Class="EAID_9385B782_D240_77F1_B17E_B578D3785F13"/>
	<FDAprofil:ModelElement base_Element="EAID_9385B782_D240_77F1_B17E_B578D3785F13" prefLabel__en_="organization" definition__en_="Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures. It is recommended that SKOS lexical labels should be used to label the Organization. In particular skos:prefLabel for the primary (possibly legally recognized name), skos:altLabel for alternative names (trading names, colloquial names) and skos:notation to denote a code from a code list. Alternative names: _Collective_ _Body_ _Org_ _Group_ " prefLabel__da_="organisation" applicationNote__da_="samling mennesker, der er organiseret i et fællesskab eller anden social, kommerciel eller politisk struktur " definition__da_="Repræsenterer en samling mennesker, der er organiseret i et fællesskab eller anden social, kommerciel eller politisk struktur. " applicationNote__en_="collection of people organized together into a community or other social, commercial or political structure " URI="http://www.w3.org/ns/org#Organization" isDefinedBy="http://www.w3.org/ns/org#"/>
	<FDAprofil:RdfsClass base_Class="EAID_9385B782_D240_77F1_B17E_B578D3785F13" prefLabel__en_="organization" definition__en_="Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures. It is recommended that SKOS lexical labels should be used to label the Organization. In particular skos:prefLabel for the primary (possibly legally recognized name), skos:altLabel for alternative names (trading names, colloquial names) and skos:notation to denote a code from a code list. Alternative names: _Collective_ _Body_ _Org_ _Group_ " subClassOf="http://xmlns.com/foaf/0.1/Agent" prefLabel__da_="organisation" applicationNote__da_="samling mennesker, der er organiseret i et fællesskab eller anden social, kommerciel eller politisk struktur " equivalentClass="http://xmlns.com/foaf/0.1/Organization" definition__da_="Repræsenterer en samling mennesker, der er organiseret i et fællesskab eller anden social, kommerciel eller politisk struktur. " applicationNote__en_="collection of people organized together into a community or other social, commercial or political structure " URI="http://www.w3.org/ns/org#Organization" isDefinedBy="http://www.w3.org/ns/org#"/>
	<thecustomprofile:recommended base_Class="EAID_BDB2AF83_FE01_0CB0_A7D1_E032C91BCAF2"/>
	<FDAprofil:ModelElement base_Element="EAID_BDB2AF83_FE01_0CB0_A7D1_E032C91BCAF2" prefLabel__en_="concept" definition__en_="&#xA;An idea or notion; a unit of thought. " prefLabel__da_="begreb" applicationNote__da_="En emne som klassificerer datasættet. " definition__da_="&#xA;En idé eller en forestilling; en tankeenhed " applicationNote__en_="A subject of a Dataset. " URI="http://www.w3.org/2004/02/skos/core#Concept"/>
	<thecustomprofile:mandatory base_Property="EAID_A5519D3D_13D6_EBB1_A3C0_71F15630B5AF"/>
	<FDAprofil:ModelElement base_Element="EAID_A5519D3D_13D6_EBB1_A3C0_71F15630B5AF"/>
	<thecustomprofile:recommended base_Association="EAID_B92C33C6_334D_AF60_A7A1_082DF0A1F80D"/>
	<thecustomprofile:recommended base_Class="EAID_BC62F805_F91E_5BE1_B527_C7F4E4885CE3"/>
	<FDAprofil:ModelElement base_Element="EAID_BC62F805_F91E_5BE1_B527_C7F4E4885CE3" prefLabel__en_="concept scheme" definition__en_="&#xA;A set of concepts, optionally including statements about semantic relationships between those concepts. " prefLabel__da_="begrebssystem" applicationNote__da_="En samling af begreber (fx. et kontrolleret udfaldsrum) hvori et givet begreb indgår." definition__da_="En samling af ét eller flere begreber, samt eventuelt også udsagn om de indbyrdes semantiske relationer mellem disse begreber. " applicationNote__en_="A concept collection (e.g. controlled vocabulary) in which the Category is defined. " URI="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
	<thecustomprofile:mandatory base_Property="EAID_8E2982E4_2551_0D79_BD5B_AB2D6BD29C68"/>
	<FDAprofil:ModelElement base_Element="EAID_8E2982E4_2551_0D79_BD5B_AB2D6BD29C68"/>
	<thecustomprofile:recommended base_Class="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F"/>
	<FDAprofil:ModelElement base_Element="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F" prefLabel__en_="personal data category" definition__en_="classification according to the sensitivity of information as defifferent conditions and procedures for processing are applicable " prefLabel__da_="personoplysningskategori" applicationNote__da_="Data kan opmærkes med en Personoplysningskategori som beskrives i Datatilsynets vejledning: almindelige personoplysninger, følsomme personoplysninger eller oplysninger om strafbare forhold. Dertil tilføjes en angivelse af fraværet af personoplysninger. " definition__da_="kategori af personoplysninger set i forhold til følsomhed idet der gælder forskellige betingelser og procedurer for behandling af oplysningerne " applicationNote__en_="Data can be marked with a category of personal data as it is described in the Danish Data Protection Agency’s guideline: general personal data, sensitive personal data or data about criminal offences. To that is added information regarding the absence of personal data. " URI="https://data.gov.dk/model/core/dcat-dk/personalDataCategory"/>
	<thecustomprofile:optional base_Association="EAID_BA5F7CCE_1E4B_428b_BE3D_483A7C886F88"/>
	<thecustomprofile:recommended base_Class="EAID_BDEBCFBD_B129_0E27_A752_089A2A703AFC"/>
	<FDAprofil:ModelElement base_Element="EAID_BDEBCFBD_B129_0E27_A752_089A2A703AFC" prefLabel__en_="public administrative task type" prefLabel__da_="forvaltningsopgave"/>
	<thecustomprofile:recommended base_Class="EAID_87CCF599_D9F4_E33B_BD21_0FC98EF2CFF7"/>
	<FDAprofil:ModelElement base_Element="EAID_87CCF599_D9F4_E33B_BD21_0FC98EF2CFF7" prefLabel__en_="confidentiality type" definition__en_="degree of confidentiality with respect to the extent by which information can be disclosed " prefLabel__da_="fortrolighedsgrad" applicationNote__da_="Anvendes som overklasse for klassen ConfidentialityTypeNatoEu der indeholder klassifikationer anvendt i henholdsvis NATO og EU." definition__da_="grad af fortrolighed forstået som i hvilket omfang information kan videregives " applicationNote__en_="Used as a super class for the class ConfidentialityTypeNatoEu that contains classification used in NATO and EU respectively " URI="https://data.gov.dk/concept/core/confidentiality-type/ConfidentialityType"/>
	<thecustomprofile:recommended base_Class="EAID_838F01C3_1644_4757_A9BD_E887210D38DD"/>
	<FDAprofil:ModelElement base_Element="EAID_838F01C3_1644_4757_A9BD_E887210D38DD" prefLabel__en_="license document" definition__en_="A legal document giving official permission to do something with a resource. " prefLabel__da_="licensdokument" applicationNote__da_="Et juridisk dokument der fastlægger de officielle tilladelser vedrørende en ressource. " definition__da_="Et juridisk dokument der fastlægger de officielle tilladelser vedrørende en ressource. " applicationNote__en_="A legal document giving official permission to do something with a resource. " URI="http://purl.org/dc/terms/LicenseDocument"/>
	<thecustomprofile:recommended base_Property="EAID_dst2C33C6_334D_AF60_A7A1_082DF0A1F80D"/>
	<thecustomprofile:recommended base_Class="EAID_9A9AA0FF_D7B1_B804_87A3_A48CB6701A8A"/>
	<FDAprofil:ModelElement base_Element="EAID_9A9AA0FF_D7B1_B804_87A3_A48CB6701A8A" prefLabel__en_="instant" definition__en_="A temporal entity with zero extent or duration" prefLabel__da_="tidspunkt" definition__da_="temporal entitet uden udstrækning eller varighed" URI="http://www.w3.org/2006/time#Instant"/>
	<thecustomprofile:optional base_Class="EAID_B02CFD16_4F46_BBB5_8C03_077940D149A1"/>
	<FDAprofil:ModelElement base_Element="EAID_B02CFD16_4F46_BBB5_8C03_077940D149A1" prefLabel__en_="identifier" definition__en_="This class is based on the UN/CEFACT Identifier complex type defined in See Section 5.8 of Core Components Data Type Catalogue Version 3.1 (http://www.unece.org/fileadmin/DAM/cefact/codesfortrade/CCTS/CCTS-DTCatalogueVersion3p1.pdf) In RDF this is expressed using the following properties: - the content string should be provided using skos:notation, datatyped with the identifier scheme (inclduing the version number if appropriate); - use dcterms:creator to link to a class describing the agency that manages the identifier scheme or adms:schemaAgency to provide the name as a literal. Although not part of the ADMS conceptual model, it may be useful to provide further properties to the Identifier class such as dcterms:created to provide the date on which the identifier was issued. " prefLabel__da_="identifikator" applicationNote__da_="En identifikator i en bestemt kontekst bestående af en streng der udgør selve idenfikatoren; en valgfri identifikator af identifikatorschemaet; en valgfri identifikator for versionen af identifikatorschemaet; en valgfri identifikator at den autoritet der administrerer identifikatorschemaet " definition__da_="Denne klasse er baseret på UN/CEFACT Identifier. " applicationNote__en_="An identifier in a particular context, consisting of the string that is the identifier; an optional identifier for the identifier scheme; an optional identifier for the version of the identifier scheme; an optional identifier for the agency that manages the identifier scheme " URI="http://www.w3.org/ns/adms#Identifier"/>
	<thecustomprofile:recommended base_Property="EAID_AF8DD9C8_C0FB_D204_ADE5_88CBBBD80DA1"/>
