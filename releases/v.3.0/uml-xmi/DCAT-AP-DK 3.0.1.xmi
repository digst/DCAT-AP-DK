	<FDAprofil:ModelElement base_Element="EAID_8F354117_12B5_F29C_91A7_6659DE600AA6" prefLabel__en_="data service" definition__en_="A site or end-point providing operations related to the discovery of, access to, or processing functions on, data or related resources. " altLabel__da_="dataservice" prefLabel__da_="datatjeneste" applicationNote__da_="Et websted eller endpoint der udstiller operationer relateret til opdagelse af, adgang til eller behandlende funktioner på data eller relaterede ressourcer. " definition__da_="Et websted eller endpoint der udstiller operationer relateret til opdagelse af, adgang til eller behandlende funktioner på data eller relaterede ressourcer. " applicationNote__en_="A collection of operations that provides access to one or more datasets or data processing functions. " URI="http://www.w3.org/ns/dcat#DataService"/>
