	<FDAprofil:ModelElement base_Element="EAID_8C507EC4_9206_00CA_B555_FAD8BCE0029F" prefLabel__en_="media type" definition__en_="A file format or physical medium. " prefLabel__da_="medietype" applicationNote__da_="Formatet for lagringen af indhold i en computerfil. " definition__da_="Et filformat eller fysisk medie. " applicationNote__en_="&#xA;A media type, e.g. the format of a computer file " URI="http://purl.org/dc/terms/MediaType"/>
	<thecustomprofile:optional base_Class="EAID_B555FAD8_BCE0_029F_8FC4_2E92EADABB55"/>
	<FDAprofil:ModelElement base_Element="EAID_B555FAD8_BCE0_029F_8FC4_2E92EADABB55" prefLabel__en_="media type" definition__en_="A file format or physical medium. " prefLabel__da_="medietype" applicationNote__da_="Formatet for lagringen af indhold i en computerfil. " definition__da_="Et filformat eller fysisk medie. " applicationNote__en_="&#xA;A media type, e.g. the format of a computer file " URI="http://purl.org/dc/terms/MediaTypeOrExtent"/>
	<thecustomprofile:optional base_Class="EAID_AFD94B8A_D329_D121_8825_CF0F3B2A2AFB"/>
	<FDAprofil:ModelElement base_Element="EAID_AFD94B8A_D329_D121_8825_CF0F3B2A2AFB" prefLabel__en_="provenance statement" definition__en_="Any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation. " prefLabel__da_="proveniensudsagn" applicationNote__da_="Denne egenskab angiver udsagn omkring datasættets oprindelse og udvikling. Proveniensudsagn erstatter ikke direkte brug af udsagn om ejerskab og varetagelse af datasættet, men er et supplement" definition__da_="Enhver ændring i en ressources ejerskabs- eller kustodeforhold siden ressourcen blev skabt som er centrale for autencitet, integritet og fortolkning. " applicationNote__en_="A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation " URI="http://purl.org/dc/terms/ProvenanceStatement"/>
	<thecustomprofile:optional base_Class="EAID_8825CF0F_3B2A_2AFB_8D3A_FA19314D29AC"/>
	<FDAprofil:ModelElement base_Element="EAID_8825CF0F_3B2A_2AFB_8D3A_FA19314D29AC" prefLabel__en_="provenance statement" definition__en_="Any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation. " prefLabel__da_="proveniensudsagn" applicationNote__da_="Denne egenskab angiver udsagn omkring datasættets oprindelse og udvikling. Proveniensudsagn erstatter ikke direkte brug af udsagn om ejerskab og varetagelse af datasættet, men er et supplement" definition__da_="Enhver ændring i en ressources ejerskabs- eller kustodeforhold siden ressourcen blev skabt som er centrale for autencitet, integritet og fortolkning. " applicationNote__en_="A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation " URI="https://www.w3.org/TR/vocab-dqv/#dqv:QualityAnnotation"/>
	<thecustomprofile:optional base_Class="EAID_8C0DD0F9_4E62_C89C_B843_F8735B63D7C9"/>
	<FDAprofil:ModelElement base_Element="EAID_8C0DD0F9_4E62_C89C_B843_F8735B63D7C9" prefLabel__en_="rights statement" definition__en_="A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights. " prefLabel__da_="rettighedsudsagn" applicationNote__da_="En beskrivelse af de intellektuelle ejendomsrettigheder forbundet med en ressource, et juridisk dokument der angiver officielle tilladelser vedrørende en ressource eller en beskrivelse af adgangsrettigheder. " definition__da_="Udsagn om de intellektuelle ejendomsrettigheder forbundet med en ressource, et juridisk dokument der angiver officielle tilladelser vedrørende en ressource eller en beskrivelse af adgangsrettigheder. " applicationNote__en_="A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights. " URI="http://purl.org/dc/terms/RightsStatement"/>
	<thecustomprofile:optional base_Class="EAID_81AA1D72_9529_D265_8ED6_6EC4F128A098"/>
	<FDAprofil:ModelElement base_Element="EAID_81AA1D72_9529_D265_8ED6_6EC4F128A098" prefLabel__en_="standard" definition__en_="A reference point against which other things can be evaluated or compared. " altLabel__da_="standard" prefLabel__da_="specifikation" applicationNote__da_="&#xA;En standard eller anden specifikation som et katalog, et datasæt, en datatjeneste eller en distribution overholder. " definition__da_="Et referencepunkt som man kan evaluere eller sammenligne andre ressourcer op i mod. " applicationNote__en_="A standard or other specification to which a Dataset or Distribution conforms " URI="http://purl.org/dc/terms/Standard"/>
	<thecustomprofile:optional base_Class="EAID_86A0BDE4_86B7_D77A_9DA3_7AF7D0777775"/>
	<FDAprofil:ModelElement base_Element="EAID_86A0BDE4_86B7_D77A_9DA3_7AF7D0777775" prefLabel__en_="quality metadata" definition__en_="&#xA;Represents quality metadata, it is defined to group quality certificates, policies, measurements and annotations under a named graph " prefLabel__da_="kvalitetsmetadata" applicationNote__da_="Repræsenterer kvalitetsmetadata (dansk tilføjelse) " definition__da_="Repræsenterer kvalitetsmetadata, og er defineret for at gruppere kvalitetscertifikater, -politikker, -målinger pg annotationer under er navngiven graf " applicationNote__en_="Represents quality metadata " URI="http://www.w3.org/ns/dqv#QualityMetadata"/>
	<thecustomprofile:optional base_Class="EAID_AE9B3914_461D_2D22_B4B1_2A9A27840BC5"/>
	<FDAprofil:ModelElement base_Element="EAID_AE9B3914_461D_2D22_B4B1_2A9A27840BC5" prefLabel__en_="usage" definition__en_="A helpful description of actions that can be performed on a given dataset or distribution " prefLabel__da_="anvendelse" applicationNote__da_="En beskrivelse af de handlinger der kan udføres med et datasæt eller dets distribution (dansk tilføjelse) " definition__da_="En beskrivelse af de handlinger der kan udføres med et datasæt eller dets distribution " applicationNote__en_="A helpful description of actions that can be performed on a given dataset or distribution " URI="http://www.w3.org/ns/duv#Usage"/>
	<thecustomprofile:optional base_Class="EAID_AB7F42E0_6683_540A_930A_52D5FC7EAA54"/>
	<FDAprofil:ModelElement base_Element="EAID_AB7F42E0_6683_540A_930A_52D5FC7EAA54" prefLabel__en_="legal resource" definition__en_="A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force).&#xA;For example, the abstract concept of the legal resource; e.g. &amp;quot;act 3 of 2005&amp;quot; (adapted from Akoma Ntoso)&#xA;&#xA;A legal resource can represent a legal act or any component of a legal act, like an article.  Legal resources can be linked together using properties defined in the model.&#xA;&#xA;Note that ELI ontology accommodates different point of view on what should be considered a new legal resource, or a new legal expression of the same resource. Typically, a consolidated version can be viewed, in the context of ELI, either as separate legal resource (linked to original version and previous consolidated version using corresponding ELI relations), or as a different legal expression of the same legal resource." altLabel__da_="retskilde" prefLabel__da_="retslig resssource" applicationNote__da_="værk i et lovgivende korpus" applicationNote__en_="A work in a legislative corpus" URI="http://data.europa.eu/eli/ontology#LegalResource"/>
	<thecustomprofile:optional base_Class="EAID_A2A670D1_4BE3_9DC6_B0DB_448F9CFADBB3"/>
	<FDAprofil:ModelElement base_Element="EAID_A2A670D1_4BE3_9DC6_B0DB_448F9CFADBB3" prefLabel__en_="document" definition__en_="A document. " prefLabel__da_="dokument" applicationNote__da_="En tekstbaseret ressourcer som indeholder information målrettet mennesker, fx. en webside som beskriver et datasæt " definition__da_="Et dokument. " applicationNote__en_="A textual resource intended for human consumption that contains information, e.g. a web page about a Dataset. " URI="http://xmlns.com/foaf/spec/#term_Document"/>
	<thecustomprofile:optional base_Class="EAID_9C9C89E7_89C4_61CF_BA26_333194AB2B72"/>
	<FDAprofil:ModelElement base_Element="EAID_9C9C89E7_89C4_61CF_BA26_333194AB2B72" prefLabel__en_="policy" definition__en_="A non-empty group of Permissions and/or Prohibitions." prefLabel__da_="politik" applicationNote__da_="samling af tilladelse og/eller forbud" definition__da_="samling af tilladelse og/eller forbud" URI="http://www.w3.org/ns/odrl/2/Policy"/>
	<thecustomprofile:optional base_Class="EAID_B81B9059_D11E_AC87_ABA2_154557706DC8"/>
	<FDAprofil:ModelElement base_Element="EAID_B81B9059_D11E_AC87_ABA2_154557706DC8" prefLabel__en_="activity" definition__en_="An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities. " prefLabel__da_="aktivitet" applicationNote__da_="noget der sker over en tidsperiode og påvirker eller interagerer med entiteter " definition__da_="&#xA;En aktivitet er noget der sker over en tidsperiode og påvirker eller interagerer med entiteter; dette kan inkludere forbrug, behandling, transformation, ændring, omplacering, anvendelse eller skabelse af entiteter. " applicationNote__en_="something that occurs over a period of time and acts upon or with entities " URI="http://www.w3.org/ns/prov#Activity"/>
	<thecustomprofile:optional base_Class="EAID_ACF38075_4071_2E57_BF0D_C0E23EAD782E"/>
	<FDAprofil:ModelElement base_Element="EAID_ACF38075_4071_2E57_BF0D_C0E23EAD782E" prefLabel__en_="attribution" definition__en_="Attribution is the ascribing of an entity to an agent. " prefLabel__da_="kreditering" definition__da_="det at kreditere en aktør for en ressource" URI="http://www.w3.org/ns/prov#Attribution"/>
	<thecustomprofile:optional base_Class="EAID_9CF70ABF_C9D9_EDD8_A36D_F65F59673000"/>
	<FDAprofil:ModelElement base_Element="EAID_9CF70ABF_C9D9_EDD8_A36D_F65F59673000" prefLabel__en_="checksum" definition__en_="A Checksum is value that allows the contents of a file to be authenticated. Even small changes to the content of the file will change its checksum. This class allows the results of a variety of checksum and cryptographic message digest algorithms to be represented " prefLabel__da_="checksum" applicationNote__da_="En checksum en en værdi som gør det muligt at verificere indholdet af en fil. Selv mindre ændringer i indholdet af en fil vil ændre dets checksum. Denne klasse gør det muligt at repræsentere resultaterne af forskellige checksum- og kryptografiske Message-Digest-algoritmer. " definition__da_="En checksum en en værdi som gør det muligt at verificere indholdet af en fil. Selv mindre ændringer i indholdet af en fil vil ændre dets checksum. Denne klasse gør det muligt at repræsentere resultaterne af forskellige checksum- og kryptografiske Message-Digest-algoritmer. " applicationNote__en_="A Checksum is value that allows the contents of a file to be authenticated. Even small changes to the content of the file will change its checksum. This class allows the results of a variety of checksum and cryptographic message digest algorithms to be represented. " URI="http://spdx.org/rdf/terms#Checksum"/>
	<thecustomprofile:mandatory base_Property="EAID_A98F8381_2E57_DA02_8ED2_7CF941E52241"/>
	<FDAprofil:ModelElement base_Element="EAID_A98F8381_2E57_DA02_8ED2_7CF941E52241"/>
	<thecustomprofile:mandatory base_Property="EAID_A5A0CBC9_B64C_D19A_AF23_5FD13B1C68A0"/>
	<FDAprofil:ModelElement base_Element="EAID_A5A0CBC9_B64C_D19A_AF23_5FD13B1C68A0"/>
	<thecustomprofile:optional base_Class="EAID_9E966D3A_9DBA_A4F7_A926_FB3832A03EEA"/>
	<FDAprofil:ModelElement base_Element="EAID_9E966D3A_9DBA_A4F7_A926_FB3832A03EEA" prefLabel__en_="kind" definition__en_="The parent class for all objects " prefLabel__da_="virtuelt visitkort" applicationNote__da_="Et virtuelt visitkort som overholder vCard-specifikationen. Anvendes eksempelvis til angivelse af telefonnummer og emailadrese for et kontaktpunkt. Bemærk at denne klasse er overklassen for de fire eksplicitte vCard-typer (Individ, Organisation, Lokation og Gruppe) " definition__da_="Moderklassen for alle objekter " applicationNote__en_="&#xA;A description following the vCard specification, e.g. to provide telephone number and e-mail address for a contact point. Note that the class Kind is the parent class for the four explicit types of vCards (Individual, Organization, Location, Group) " URI="http://www.w3.org/2006/vcard/ns#Kind"/>
	<FDAprofil:LogicalDataModel base_Package="EAPK_BADBC80E_0E7F_8CD2_B375_F1B0E996E73A" modified="15-07-2026" wasDerivedFrom="DCAT-AP" legalSource="https://www.retsinformation.dk/eli/lta/2005/596" namespace="https://data.gov.dk/model/profile/dcat-ap-dk-2.0.1/" modelScope="application model" responsibleEntity="Digitaliseringsstyrelsen" language="en" approvedBy="Udvalget for Arkitektur og Standarder" modelStatus="http://purl.org/adms/status/Stable" publisher="Digitaliseringsstyrelsen" source="https://www.w3.org/TR/vocab-dcat/" namespacePrefix="dcat-ap-dk" theme="https://form-online.dk/opgavenoegle/16/#16.05.07" approvalStatus="https://data.gov.dk/concept/core/ApprovalStatus/Approved" versionInfo="3.0.1"/>
	<thecustomprofile:versionNotes base_Package="EAPK_BADBC80E_0E7F_8CD2_B375_F1B0E996E73A" versionNotes="version 3.0.1 - mindre fejlrettelser&#xA;version 3.0.0 - opdatering til overenstemmelse med DCAT-AP 3.0.0 og &#xA;&#xA;Alle særlige danske kravniveauer udgår&#xA;&#xA;Følgende danske egenskaber udfases fordi de (nu) kan udtrykkes i DCAT-AP på anden vis og ikke reelt er taget i brug:&#xA;&#xA;    Datasætansvarlig organisation - brug i stedet kvalificeret kreditering + passende rolle, fx custodian&#xA;&#xA;    Bidragsyder - brug i stedet kvalificeret kreditering + passende rolle, fx contributor&#xA;&#xA;    Vedligeholder - brug i stedet kvalificeret kreditering + passende rolle, fx maintainer&#xA;&#xA;    Hjemmel - brug i stedet applicable legislation&#xA;&#xA;    Betalingspålagt – brug i stedet ’has policy’ + ODRL&#xA;&#xA;org:Organization udgår som udfaldsrum for datasætansvarlig organisation, men anbefales (som i DCAT-AP) anvendt når aktør er en organisation.&#xA;&#xA;Personoplysningskategori (dcat-dk:personalDataCategory) ændrer udfaldsrum til udarbejdet standard for Personoplysningskategorier.&#xA;&#xA;Fortrolighedsgrad (dcat-dk:confidentialityType) ændrer udfaldsrum til udarbejdet standard for Fortrolighedsgrader iht. sikkerhedscirkulæret (EU/NATO).&#xA;&#xA;Datakvalitetsoplysninger ændrer egenskaber:&#xA;&#xA;Udfasning af duv:usage (Anvendelse), duv:hasUsage (har anvendelse), dqv:QualityMetadata (Kvalitetsmetadata) og dqv:hasQualityMetadata (har kvalitetsmetadata)&#xA;&#xA;Indførelse af dqv:QualityAnnotation (Kvalitetsannotation), dqv:hasQualityAnnotation (har kvalitetsannotation) og dqv:inDimension (i dimension)&#xA;&#xA;Kvalitetsannotation peger på beskrivelse af en enkelt datakvalitetsdimension (og der kan så være flere per datasæt), hvor Kvalitetsmetadata pegede på det fulde erklæringsdokument, der så indeholdt annotationerne."/>
	<FDAprofil:ModelElement base_Element="EAPK_BADBC80E_0E7F_8CD2_B375_F1B0E996E73A" wasDerivedFrom="DCAT-AP" legalSource="https://www.retsinformation.dk/eli/lta/2005/596" label__en_="DCAT-AP-DK 3.0.1" label__da_="DCAT-AP-DK 3.0.1" source="https://www.w3.org/TR/vocab-dcat/" comment__da_="DCAT-AP-DK er en specifikation til beskrivelse af datasæt og datakataloger til anvendelse i dansk fællesoffentlig regi. Specifikationen omfatter basisoplysninger om datasæt, som fx titel, beskrivelse, udgiver, udgivelsesdato mv., samt en ensartet struktur for disse oplysninger i et fælles udvekslingsformat, som gør det muligt at dele oplysninger om datasæt på en effektiv måde." comment__en_="DCAT-AP-DK is a specification for the description of dataset and data catagloues to be used in the Danish public sector"/>
</xmi:XMI>