	<thecustomprofile:mandatory base_Class="EAID_9C698EC4_A1C8_3FBE_9EB4_F63B8DC7CEA8"/>
	<FDAprofil:ModelElement base_Element="EAID_9C698EC4_A1C8_3FBE_9EB4_F63B8DC7CEA8" prefLabel__en_="agent" definition__en_="An agent (eg. person, group, software or physical artifact)." prefLabel__da_="aktør" applicationNote__da_="En entitet som er tilknyttet kataloget, datasættet eller datatjenesten. Hvis aktøren er en organisation, så anbefales det at denne opmærkes med W3Cs The Organization Ontology (https://www.w3.org/TR/vocab-org/) " definition__da_="En aktør (fx. person, gruppe, software eller fysisk artefakt). " applicationNote__en_="&#xA;An entity that is associated with Catalogues and/or Datasets. If the Agent is an organisation, the use of the Organization Ontology is recommended. " URI="http://xmlns.com/foaf/0.1/Agent"/>
	<thecustomprofile:mandatory base_Property="EAID_B38ED4FA_0E28_862C_AC1A_B68E405CDE99"/>
	<FDAprofil:ModelElement base_Element="EAID_B38ED4FA_0E28_862C_AC1A_B68E405CDE99"/>
