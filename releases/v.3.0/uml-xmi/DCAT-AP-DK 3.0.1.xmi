					<tag xmi:id="EAID_59BB15E0_29BA_af29_9255_475F9C92C228" name="applicationNote (da)" value="&lt;memo&gt;#NOTES#samling mennesker, der er organiseret i et fællesskab eller anden social, kommerciel eller politisk struktur " modelElement="EAID_9385B782_D240_77F1_B17E_B578D3785F13"/>
					<tag xmi:id="EAID_59BB1BCE_2FA8_af2f_AAFA_E14D9AD785C9" name="applicationNote (en)" value="&lt;memo&gt;#NOTES#collection of people organized together into a community or other social, commercial or political structure " modelElement="EAID_9385B782_D240_77F1_B17E_B578D3785F13"/>
					<tag xmi:id="EAID_6D3BD229_AC23_6eac_B054_165F249D73B7" name="comment (da)" value="&lt;memo&gt;" modelElement="EAID_9385B782_D240_77F1_B17E_B578D3785F13"/>
