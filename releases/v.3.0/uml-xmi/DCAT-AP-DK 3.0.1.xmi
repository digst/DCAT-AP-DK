	<FDAprofil:ModelElement base_Element="EAID_AC0DE9C3_F73C_E345_81EE_DFF46C68EEA6" prefLabel__en_="catalog record" definition__en_="A record in a data catalog, describing the registration of a single dataset or data service. " prefLabel__da_="katalogpost" applicationNote__da_="Post i et datakatalog der beskriver registreringen af et enkelt datasæt eller en enkelt datatjeneste. " definition__da_="En post i et datakatalog der beskriver registreringen af et enkelt datasæt eller en datatjeneste. " applicationNote__en_="&#xA;A description of a Dataset’s entry in the Catalogue. " URI="http://www.w3.org/ns/dcat#CatalogRecord"/>
