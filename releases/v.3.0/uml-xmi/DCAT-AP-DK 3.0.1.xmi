	<thecustomprofile:optional base_Class="EAID_9A82EAA5_19DA_FF7D_B0F2_A49BF2162072"/>
	<FDAprofil:ModelElement base_Element="EAID_9A82EAA5_19DA_FF7D_B0F2_A49BF2162072" prefLabel__en_="linguistic system" definition__en_="A system of signs, symbols, sounds, gestures, or rules used in communication. " prefLabel__da_="lingvistisk system" applicationNote__da_="Et system bestående af tegn, symboler, lyde, gestikulation eller regler anvendt i kommunikation, fx. et sprog. " definition__da_="Et system bestående af tegn, symboler, lyde, gestikulation eller regler anvendt i kommunikation. " applicationNote__en_="A system of signs, symbols, sounds, gestures, or rules used in communication, e.g. a language " URI="http://purl.org/dc/terms/LinguisticSystem"/>
	<thecustomprofile:optional base_Class="EAID_85DC6437_2530_0BAC_AC4E_C97368A6F078"/>
	<FDAprofil:ModelElement base_Element="EAID_85DC6437_2530_0BAC_AC4E_C97368A6F078" prefLabel__en_="location" definition__en_="Spatial characteristics of the resource. " prefLabel__da_="lokation" applicationNote__da_="Denne egenskab angiver et geografisk område som kataloget dækker. Afgræsningen kan enten udtrykkes ved udpegnings af geofrafisk område eller ved anvendelse af en af følgende klassifikationen: EU Vocabularies Continents Named Authority List, EU Vocabularies Countries Named Authority List, EU Vocabularies Places Named Authority List eller Geonames (Sidstnævnte bør kun anvendes såfremt lokationen ikke findes i et af de nævnte EU Authority Lists. " definition__da_="Ressourcens geografiske karakteristika. " applicationNote__en_="This property refers to a geographical area covered by the Catalogue. " URI="http://purl.org/dc/terms/Location"/>
	<thecustomprofile:optional base_Property="EAID_A7265053_5F96_7889_86A5_99E0980BA088"/>
	<FDAprofil:ModelElement base_Element="EAID_A7265053_5F96_7889_86A5_99E0980BA088"/>
