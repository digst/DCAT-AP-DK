						<tag xmi:id="EAID_A4698AD5_4211_D3A1_90A7_79CF24C5321C" name="altLabel (da)" value="$ea_notes="/>
						<tag xmi:id="EAID_A9E30D1A_F196_55AD_ADB9_1A88C7DF32F7" name="comment (da)" value="&lt;memo&gt;$ea_notes=Et centralt emne for ressourcen. En ressource kan have flere centrale emner."/>
						<tag xmi:id="EAID_AEBB4E16_22D8_D884_B015_E2F72DFD861B" name="applicationNote (da)" value="&lt;memo&gt;$ea_notes=Denne egenskab angiver et emne for datasættet. Et datasæt kan opmærkes med flere forskellige emner - eventuelt fra flere forskellige klassifikationer.&#xA;&#xA;Anvendelse af EUs klassifikation Dataset Theme er anbefalet, se http://publications.europa.eu/resource/authority/data-theme. Anvendelse af FORM (http://www.form-online.dk/) og KLE (http://www.kle-online.dk/) til opmærkning med forvaltningsopgave er valgfrit, og det foreslås, at KLE anvendes af kommunerne, og FORM af regioner og statslige administrative enheder."/>
						<tag xmi:id="EAID_B3F2F390_31CD_8D0E_B776_D17AFD2E5471" name="label (da)" value="$ea_notes="/>
						<tag xmi:id="EAID_B61FB327_19F8_8812_B3A0_19FDF2FFB456" name="applicationNote (en)" value="&lt;memo&gt;$ea_notes=This property refers to a category of the Dataset. A Dataset may be associated with multiple themes - potentially from different classifications&#xA;&#xA;The use of the EU Dataset Themes is recommended, see http://publications.europa.eu/resource/authority/data-theme. Using FORM - the Danish Public Task Reference Model - (http://www.form-online.dk/) and KLE - a Municipal Task Reference Model - (http://www.kle-online.dk/) for thematic categorisation is optional, and it is suggested that KLE is used by municipalities and FORM by regional and govermental authorities"/>
						<tag xmi:id="EAID_BA050985_EB82_098E_8050_7A0147576C10" name="deprecatedLabel (en)" value="$ea_notes="/>
						<tag xmi:id="EAID_BB2D43C7_D415_01CB_B4BC_6A2C407DB1C6" name="prefLabel (en)" value="theme"/>
						<tag xmi:id="EAID_BB9416D1_2AB1_7004_813A_D833A150B394" name="definition (en)" value="&lt;memo&gt;$ea_notes="/>
						<tag xmi:id="EAID_BBA3327D_04A2_1D3D_A22A_A1EFDDB86B7F" name="example (da)" value="&lt;memo&gt;$ea_notes="/>
