					<documentation/>
					<xrefs value="$XREFPROP=$XID={BFE1852B-5AB9-5AF8-9576-746B27883796}$XID;$NAM=Stereotypes$NAM;$TYP=connectorDestEnd property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=optional;FQName=SysML1.1::optional;@ENDSTEREO;$DES;$CLT={82F5974A-F864-0FE9-A833-8DA6612CB741}$CLT;$ENDXREF;"/>
					<tags>
						<tag xmi:id="EAID_828AF14E_E73A_96D7_BEE6_707995AE6DB3" name="comment (en)" value="&lt;memo&gt;$ea_notes="/>
						<tag xmi:id="EAID_84DD9083_6004_90B7_9CB5_3CCBCEE9767B" name="definition (en)" value="&lt;memo&gt;$ea_notes=The compression format of the distribution in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file."/>
						<tag xmi:id="EAID_88081517_ED1C_1538_9F03_EB4DDB141F8B" name="label (da)" value="$ea_notes="/>
						<tag xmi:id="EAID_8B62382A_8F67_805D_ABF0_6A856C017F44" name="source" value="$ea_notes="/>
						<tag xmi:id="EAID_8D114D46_02D0_224A_A248_6390EEF65C41" name="deprecatedLabel (en)" value="$ea_notes="/>
						<tag xmi:id="EAID_8D4CAA94_1748_11C5_912B_49C5C8CF42F0" name="applicationNote (en)" value="&lt;memo&gt;$ea_notes=This property refers to the format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file. It SHOULD be expressed using a media type as defined in the official register of media types managed by IANA."/>
						<tag xmi:id="EAID_960B2C7B_E163_5D50_B976_86EB171B2AA5" name="comment (da)" value="&lt;memo&gt;$ea_notes="/>
						<tag xmi:id="EAID_968A1EEF_50D8_901B_A3D7_DCC53FE5FDFE" name="applicationNote (da)" value="&lt;memo&gt;$ea_notes=Denne egenskab angiver filformatet for den distribution hvori data er indholdt i et komprimeret format, fx. med det formål at reducere størrelsen af downloadfilen. Formatet BØR udtrykkes med en medietype defineret af Internet Assigned Numbers Authority (IANA) (https://www.iana.org/assignments/media-types/media-types.xhtml)"/>
						<tag xmi:id="EAID_96FA985A_2EC7_D282_B54D_B8D327C2BBA3" name="altLabel (en)" value="$ea_notes="/>
