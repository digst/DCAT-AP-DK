						<tag xmi:id="EAID_AFEB6CA3_689C_C46F_A327_294DAD1C2E9C" name="definition (en)" value="&lt;memo&gt;$ea_notes=Links to the status of the Asset or Asset Distribution in the context of a particular workflow process. Since Status is defined using a skos:Concept, that is the defined range for this property."/>
						<tag xmi:id="EAID_AFF60B11_70FE_639C_90ED_8F705F346378" name="applicationNote (en)" value="&lt;memo&gt;$ea_notes=This property refers to the maturity of the Distribution. It MUST take one of the values Completed, Deprecated, Under Development, Withdrawn."/>
						<tag xmi:id="EAID_BA77F768_4BEB_5EF8_BC91_FEA1DE3FFD5D" name="prefLabel (en)" value="status"/>
						<tag xmi:id="EAID_BD1BC2C6_EC6E_524E_BC27_BB0E9634C2CA" name="deprecatedLabel (da)" value="$ea_notes="/>
