					<tag xmi:id="EAID_E4EE276D_7727_6777_971F_5223B9681CBE" name="definition (en)" value="&lt;memo&gt;#NOTES#classification according to the sensitivity of information as defifferent conditions and procedures for processing are applicable " modelElement="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F"/>
