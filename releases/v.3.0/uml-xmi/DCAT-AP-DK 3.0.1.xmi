					<tag xmi:id="EAID_59BB15E0_29BA_af29_8B6D_856E6174D372" name="applicationNote (da)" value="&lt;memo&gt;#NOTES#Data kan opmærkes med en Personoplysningskategori som beskrives i Datatilsynets vejledning: almindelige personoplysninger, følsomme personoplysninger eller oplysninger om strafbare forhold. Dertil tilføjes en angivelse af fraværet af personoplysninger. " modelElement="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F"/>
					<tag xmi:id="EAID_59BB1BCE_2FA8_af2f_8F91_AC77C589A4DD" name="applicationNote (en)" value="&lt;memo&gt;#NOTES#Data can be marked with a category of personal data as it is described in the Danish Data Protection Agency’s guideline: general personal data, sensitive personal data or data about criminal offences. To that is added information regarding the absence of personal data. " modelElement="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F"/>
					<tag xmi:id="EAID_6D3BD229_AC23_6eac_9C22_382EFFEC5EF6" name="comment (da)" value="&lt;memo&gt;" modelElement="EAID_B7E3DED1_6D56_7ABF_BEFD_ADBE42147E8F"/>
